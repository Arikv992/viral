# ───────── VIRAL-OPS — copia para .env e preenche o que tiveres ─────────
# Nenhuma chave é obrigatória: sem chaves a plataforma corre em modo grátis
# (heurísticas, voz Edge/Piper, arte procedural, exportação para upload manual).

# Cérebro (estratégia, guiões, packaging, diagnóstico) — https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_FALLBACKS=true

# Dados de mercado — YouTube Data API v3 (Google Cloud Console > APIs > YouTube Data API v3 > API key)
YOUTUBE_API_KEY=
# Publicação + Analytics — OAuth "Desktop/Web app" client_secret.json (ativa YouTube Data API v3 e YouTube Analytics API)
# Redirect URI a registar: http://localhost:8000/api/publish/oauth/callback
GOOGLE_CLIENT_SECRETS=

# Produção
PEXELS_API_KEY=          # stock vídeo/foto grátis — https://www.pexels.com/api/
PIXABAY_API_KEY=         # stock grátis — https://pixabay.com/api/docs/
FAL_API_KEY=             # imagens Flux + vídeo Kling/Veo — https://fal.ai
ELEVENLABS_API_KEY=      # voz premium (usada só quando o ROI compensa)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# TikTok (futuro) — Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Dinheiro (também editável na UI → Piloto automático)
MONTHLY_BUDGET_USD=50
REINVEST_RATIO=0.5

# Piloto automático
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_HOURS=6
AUTO_PUBLISH=false
